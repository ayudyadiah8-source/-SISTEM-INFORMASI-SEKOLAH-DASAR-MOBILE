<?xml version="1.0" encoding="utf-8"?>
<!-- Letakkan di: app/src/main/res/layout/fragment_profil.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header navy, meniru kartu "Selamat Datang" di dashboard admin -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sdn_navy"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👋 Selamat Datang!"
            android:textColor="@color/sdn_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="-"
            android:textColor="#C7D7F5"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="PENGATURAN"
            android:textColor="@color/sdn_navy"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTokenFcm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_stat"
            android:padding="12dp"
            android:text="Notifikasi: aktif"
            android:textColor="@color/sdn_navy"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/sdn_red"
            android:text="Keluar"
            android:textColor="@color/sdn_white" />

    </LinearLayout>
</LinearLayout>