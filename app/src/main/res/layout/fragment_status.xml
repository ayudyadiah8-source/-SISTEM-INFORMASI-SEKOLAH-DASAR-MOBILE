<?xml version="1.0" encoding="utf-8"?>
<!-- Letakkan di: app/src/main/res/layout/fragment_status.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="STATUS DAFTAR ULANG"
        android:textColor="@color/sdn_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Ketuk dan tahan salah satu baris untuk melihat opsi."
        android:textColor="#90A4AE"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/listStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>